# Database (Prisma datasource). Copy to .env and set real values.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/domora_dev"

# Separate DB for the integration test suite (vitest). Disposable.
DATABASE_URL_TEST="postgresql://postgres:CHANGE_ME@localhost:5432/domora_test"

# Full path to psql.exe for the test DB setup (only needed when not on PATH).
PSQL_BIN="C:\Program Files\PostgreSQL\16\bin\psql.exe"

# Allowed request Origin for state-changing requests (SEC-9).
APP_ORIGIN="http://localhost:3000"

# Session signing secret (jose HS256). Minimum 32 bytes; generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# PRD names no auth mechanism. This value backs the recorded session default (SEC-1 open item).
SESSION_SECRET="change-me-48-random-bytes-hex"

# Storage provider is NOT named in the PRD. /lib/storage fails closed until the
# owner names one (UP-1 fail closed). Keep these empty in the scaffold.
STORAGE_BUCKET=""
STORAGE_BUCKET_DOCUMENTS=""

# One-time geocode-at-creation call. Provider is NOT named in the PRD.
# /lib/geocoding fails closed until the owner names one.
GEOCODING_PROVIDER=""